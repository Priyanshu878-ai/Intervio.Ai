# ==========================================
# Intervio.Ai Monorepo .gitignore
# ==========================================

# --- Node & Next.js (Frontend) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.vercel
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python & Virtual Environments (Backend / ML) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# --- Environment & Secret Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# --- Machine Learning Artifacts & Heavy Datasets ---
# Exclude raw, processed, and cache data directories, keeping structural / metadata tracked
data/raw/
data/processed/
data/cache/
checkpoints/
models/saved/
ml/checkpoints/
ml/models/saved/

# Heavy ML Model Weights & Binary Checkpoints
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.ckpt
*.tflite
*.pb

# --- Database & Local Storage ---
*.sqlite3
*.db
postgres_data/

# --- IDE & Editor Files ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
