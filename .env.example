# ==========================================
# Intervio.Ai - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit actual secret credentials or .env files.

# --- Database Configuration (PostgreSQL 17) ---
POSTGRES_USER=intervio_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=intervio_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://intervio_user:your_secure_password_here@localhost:5432/intervio_db

# --- FastAPI Backend Server Settings ---
BACKEND_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=your_development_secret_key_change_in_production
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Machine Learning Pipeline Configuration ---
ML_DEVICE=cpu                            # cpu or cuda
HUGGINGFACE_HUB_CACHE=./ml/cache/hf
TRANSFORMERS_CACHE=./ml/cache/transformers
TORCH_HOME=./ml/cache/torch
SPEECH_MODEL_CACHE=./ml/cache/whisper
